{
  "$comment": "隐私三级规则。命中即按 action 处理；正则用 JS 语法（tools/pii-scan.mjs 直接读取）。改这里前先备份。",
  "version": "1.0.0",
  "allowlist": {
    "$comment": "官方文档里的**示例值**：它们是公开的占位符，不是凭据。命中后放行，但会记一条提示（不静默）。故意收得很窄：只认逐字全等的这几串，不做前缀/模糊匹配——模糊匹配等于给真凭证开后门。新增一条之前先问：这串值在任何人的账号里能用吗？能用就别加。",
    "exact": [
      "AKIAIOSFODNN7EXAMPLE",
      "AKIAI44QH8DHBEXAMPLE",
      "sk-ant-api03-EXAMPLE",
      "ghp_0000000000000000000000000000000000"
    ]
  },
  "levels": {
    "L1": {
      "label": "硬红线",
      "action": "block",
      "meaning": "命中即终止本次操作，任何情况下不得出网、不得写入可同步目录。",
      "patterns": [
        { "id": "cn-id-card", "kind": "identity", "regex": "(?<![0-9])[1-9]\\d{5}(?:19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[0-9Xx](?![0-9])", "note": "中国大陆 18 位身份证" },
        { "id": "bank-card", "kind": "finance", "regex": "(?<![0-9])(?:6[0-9]{15,18}|4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14})(?![0-9])", "note": "银行卡号（62/4/5 开头）" },
        { "id": "passport", "kind": "identity", "regex": "(?<![0-9A-Za-z])[EGDSP]\\d{8}(?![0-9A-Za-z])", "note": "护照号" },
        { "id": "api-key-literal", "kind": "credential", "flags": "gi", "regex": "(?:sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[abp]-[A-Za-z0-9-]{10,})", "note": "常见 API Key 形态（大小写不敏，靠 flags:gi，不要写内联 (?i)——JS 不支持，会让整条规则静默失效）" },
        { "id": "private-key-block", "kind": "credential", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]{20,}", "note": "私钥块" },
        { "id": "secret-assignment", "kind": "credential", "regex": "(?:密码|口令|私钥|密钥|验证码|token|secret|passwd|password|api[_-]?key)\\s*[：:=＝]\\s*[^\\s，。；;,]{4,}", "note": "关键词后跟分隔符与值（疑似真实凭据，不是「讨论这个词」）" }
      ],
      "keywords": ["密码", "口令", "私钥", "密钥", "token", "access_key", "secret_key", "验证码", "银行卡密码", "指纹", "人脸", "虹膜", "DNA", "基因检测"],
      "_keywords_note": "2026-11-07 起：L1 关键词**裸词命中不再拦**（只作提示，降为 L2 一起脱敏处理）。理由是真机实测 6 篇技术文档 5 篇被裸词误杀、0 篇含真实敏感值——「在讨论 token 计费」不等于「泄露了 token」。真正的凭据由上面的正则兜（api-key-literal / private-key-block / secret-assignment）。"
    },
    "L2": {
      "label": "软红线",
      "action": "confirm-then-redact",
      "meaning": "默认本地处理。确需出网时，必须脱敏为占位符并由宿主逐条确认。",
      "patterns": [
        { "id": "cn-mobile", "kind": "phone", "regex": "(?<![0-9])1[3-9]\\d{9}(?![0-9])", "note": "手机号" },
        { "id": "email", "kind": "email", "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "note": "邮箱" },
        { "id": "name-field", "kind": "name", "regex": "(?:我叫|姓名|联系人|收件人|户名)[：: ]?[\\u4e00-\\u9fa5]{2,4}", "note": "带字段名的真实姓名" },
        { "id": "name-honorific", "kind": "name", "regex": "[\\u4e00-\\u9fa5]{2,3}(?:先生|女士|老师|同学|总)(?![\\u4e00-\\u9fa5])", "note": "带敬称的姓名" },
        { "id": "address-field", "kind": "address", "regex": "(?:住址|家庭地址|详细地址|收货地址|门牌)[：: ]?[^\\n]{4,40}", "note": "详细住址" },
        { "id": "account-field", "kind": "account", "regex": "(?:账号|帐号|学号|工号|社保号|医保号|公积金号)[：: ]?[A-Za-z0-9-]{4,}", "note": "各类账号" }
      ],
      "keywords": ["工资", "薪资", "收入", "存款", "余额", "贷款", "账单", "房贷", "病历", "诊断", "处方", "病史", "住院", "用药", "体检报告", "聊天记录", "私聊", "群聊", "微信记录", "家庭关系", "身份证", "护照", "户口", "情绪", "焦虑", "抑郁", "失眠", "崩溃", "想哭"]
    },
    "L3": {
      "label": "观察项",
      "action": "record-only",
      "meaning": "只记录到画像参考，不拦截、不脱敏。",
      "patterns": [
        { "id": "city", "kind": "location", "regex": "(?:北京|上海|广州|深圳|杭州|成都|武汉|南京|西安|重庆|苏州|天津|长沙|郑州|青岛|合肥|福州|厦门|宁波|无锡|东莞|佛山)", "note": "城市" }
      ],
      "keywords": ["公司", "单位", "部门", "项目代号", "昵称", "代号", "学校"]
    }
  },
  "placeholderMap": {
    "identity": "ID",
    "finance": "BANK",
    "credential": "SECRET",
    "phone": "PHONE",
    "email": "EMAIL",
    "name": "NAME",
    "address": "ADDR",
    "account": "ACCT",
    "location": "CITY"
  },
  "nameDictionary": [],
  "$nameDictionary_comment": "把你自己的真名、家人姓名、常用账号前缀填进来，命中率会显著提升。例如 [\"张三\", \"李四\"]",
  "egressAllowlist": [],
  "$egressAllowlist_comment": "允许出网的域名白名单，默认空 = 全部禁止外发个人信息。"
}
